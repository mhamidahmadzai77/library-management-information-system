@model Site.Models.PublicationQueryResultModel
@using Site.Controllers;

@{
    @* if (Session["user"] != null)
        {
            if (Session["user"].ToString() == "authenticated")
            {
                if (Session["level"].ToString() == "admin")
                {
                    Layout = "~/Views/Shared/_AdminLayout.cshtml";
                }
                if (Session["level"].ToString() == "director")
                {
                    Layout = "~/Views/Shared/_UserLayout.cshtml";
                }
            }
            else if (Session["user"].ToString() == "locked")
            {
                // Redirect to lock sreen page using javascript
                <script>
                    window.location.href = '@Url.Action("LockScreen","User")'
                </script>
            }

        }
        else
        {
            Layout = "~/Views/Shared/_GeneralLayout.cshtml";
        }
    *@

    Layout = "~/Views/Shared/_AdminLayout.cshtml";


}


@{
    Site.Models.PublicationResultModel row = null;
}
@foreach (var item in Model.QueryResults)
{
    row = item;

}

<html lang="en">
<head>
    <title></title>


    <meta charset="utf-8" />
    <meta name="viewport" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />

    <script src="~/assets/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>


    <style>
        .tab-content {
            display: none;
        }

        #tab1 {
            display: block;
        }

        .btnDelete:hover {
            cursor: pointer;
        }

        .btnEdit:hover {
            cursor: pointer;
        }
    </style>

</head>
<body>

    <div id="tab1" class="tab-content" style="padding-bottom:50px;">
        <div class="note note-success">
            <h4 class="block"> د @row.publication_name کتاب ټول معلومات</h4>
        </div>
        <div class="note note-success">
            <h4 class="form-section"> د @row.publication_name کتاب عمومي مشخصات</h4>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-1"></div>
            <div class="col-md-10">
                
            </div>
            <div class="col-md-1"></div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب نړیوال/ISBN نمبر : </label>
                        </div>
                        <div class="col-md-10">
                            @row.ISBN
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب دیوي/DDC نمبر : </label>
                        </div>
                        <div class="col-md-10">
                            @row.DDC_classificationNo
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب LLC نمبر : </label>
                        </div>
                        <div class="col-md-10">
                            @row.LLC_classificationNo
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب نوم : </label>
                        </div>
                        <div class="col-md-10">
                            @row.publication_name
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> ژباړن/ژباړونکي : </label>
                        </div>
                        <div class="col-md-10">
                            @row.translator
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> لیکوال/لیکوالان : </label>
                        </div>
                        <div class="col-md-10">

                            @row.authors
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د لیکوال/لیکوالانو معلومات : </label>
                        </div>
                        <div class="col-md-10">
                            @row.author_description
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> دتأسیس ډول : </label>
                        </div>
                        <div class="col-md-10">
                            @row.publication_type
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> شعبه: </label>
                        </div>
                        <div class="col-md-10">
                            @row.branch
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب ډول : </label>
                        </div>
                        <div class="col-md-10">
                            @row.book_type
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب د وړلو اجازه : </label>
                        </div>
                        <div class="col-md-10">
                            @if (row.permission == false)
                            {
                                <span>شته</span>

                            }
                            @if (row.permission == true)
                            {
                                <span>نشته</span>

                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> ژبه : </label>
                        </div>
                        <div class="col-md-10">
                            @row.publication_language
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> اضافه معلومات : </label>
                        </div>
                        <div class="col-md-10">
                            @row.publication_description
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د وړنې اجازه : </label>
                        </div>
                        <div class="col-md-10">
                            @if (row.permission)
                            {
                                <span> نشته </span>
                            }
                            else
                            {
                                <span> شته </span>

                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="note note-success">
            <h4 class="form-section"> د هر جلد او چاپ معلومات</h4>
        </div>
       
        <div class="table-scrollable">
            <table class="table table-striped table-bordered table-hover" id="">
                <thead class="bg-blue-oleo bg-font-blue-oleo">
                    <tr>
                        <th> # </th>
                        <th> جلد </th>
                        <th> چاپ </th>
                        <th> د تأسیس ځل </th>
                        <th> د تأسیس ځای </th>
                        <th style="min-width:100px;"> مطبعه </th>
                        <th> تعداد </th>
                        <th> موجوده تعداد </th>
                        <th> صفحې </th>
                        <th> CDs </th>
                        <th> د ثبت د تاریخ ډول </th>
                        <th> د ثبت کال </th>
                        <th> د ثبت میاشت </th>
                        <th> د ثبت ورځ </th>
                        <th> د چاپ د تاریخ ډول </th>
                        <th> د چاپ کال </th>
                        <th> د چاپ میاشت </th>
                        <th> د چاپ ورځ </th>
                        <th> د المارۍ نمبر </th>
                        <th> د خانې نمبر </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int No = 0;

                        foreach (var col in Model.QueryResults)
                        {
                            No++;
                           
                            @* var registration_date_type = "";
                                var publication_date_type = "";

                                if (col.registration_date_type == "شمسي")
                                {
                                    registration_date_type = "Shasi";
                                }
                                else if (col.registration_date_type == "قمري")
                                {
                                    registration_date_type = "Qamari";
                                }
                                else
                                {
                                    registration_date_type = "Meladi";
                                }


                                if (col.publication_date_type == "شمسي")
                                {
                                    publication_date_type = "Shasi";
                                }
                                else if (col.publication_date_type == "قمري")
                                {
                                    publication_date_type = "Qamari";
                                }
                                else
                                {
                                    publication_date_type = "Meladi";
                                }*@
                            var TDSegmentNo = "TDSegmentNo" + col.edition_id;
                            var TDEditionNo = "TDEditionNo" + col.edition_id;
                            var TDPublicationNo = "TDPublicationNo" + col.edition_id;
                            var TDPublicationPlace = "TDPublicationPlace" + col.edition_id;
                            var TDPublisherName = "TDPublisherName" + col.edition_id;
                            var TDPublicationQuantity = "TDPublicationQuantity" + col.edition_id;
                            var TDAvailableQuantity = "TDAvailableQuantity" + col.edition_id;
                            var TDPublicationPages = "TDPublicationPages" + col.edition_id;
                            var TDCDQuantity = "TDCDQuantity" + col.edition_id;
                            var TDRegistrationDateType = "TDRegistrationDateType" + col.edition_id;
                            var TDRegistrationYear = "TDRegistrationYear" + col.edition_id;
                            var TDRegistrationMonth = "TDRegistrationMonth" + col.edition_id;
                            var TDRegistrationDay = "TDRegistrationDay" + col.edition_id;
                            var TDPublicationDateType = "TDPublicationDateType" + col.edition_id;
                            var TDPublicationYear = "TDPublicationYear" + col.edition_id;
                            var TDPublicationMonth = "TDPublicationMonth" + col.edition_id;
                            var TDPublicationDay = "TDPublicationDay" + col.edition_id;
                            var TDCupboardNo = "TDCupboardNo" + col.edition_id;
                            var TDCellNo = "TDCellNo" + col.edition_id;
                            <tr>
                                <td style="text-align:center;"> @No </td>
                                <td style="text-align:center;" id="@TDSegmentNo">@col.segment_no</td>
                                <td style="text-align:center;" id="@TDEditionNo">@col.edition_no</td>
                                <td style="text-align:center;" id="@TDPublicationNo">@col.publication_no</td>
                                <td style="text-align:center;" id="@TDPublicationPlace">@col.publication_place</td>
                                <td style="text-align:center; min-width:100px;" id="@TDPublisherName">@col.publisher_name</td>
                                <td style="text-align:center;" id="@TDPublicationQuantity">@col.publication_quantity</td>
                                <td style="text-align:center;" id="@TDAvailableQuantity">@col.availableQuantity</td>
                                <td style="text-align:center;" id="@TDPublicationPages">@col.publication_pages</td>
                                <td style="text-align:center;" id="@TDCDQuantity">@col.cd_quantity</td>
                                <td style="text-align:center;" id="@TDRegistrationDateType">@col.registration_date_type</td>
                                <td style="text-align:center;" id="@TDRegistrationYear">@col.registration_year</td>
                                <td style="text-align:center;" id="@TDRegistrationMonth">@col.registration_month</td>
                                <td style="text-align:center;" id="@TDRegistrationDay">@col.registration_day</td>
                                <td style="text-align:center;" id="@TDPublicationDateType">@col.publication_date_type</td>
                                <td style="text-align:center;" id="@TDPublicationYear">@col.publication_year</td>
                                <td style="text-align:center;" id="@TDPublicationMonth">@col.publication_month</td>
                                <td style="text-align:center;" id="@TDPublicationDay">@col.publication_day</td>
                                <td style="text-align:center;" id="@TDCupboardNo">@col.cupboard_no</td>
                                <td style="text-align:center;" id="@TDCellNo">@col.cell_no</td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

    </div>


    <script src="~/assets/alert.js"></script>
    <script src="~/assets/pages/scripts/components-select2.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquer.js"></script>
    <script src="~/assets/book/script.js"></script>
    <script src="~/assets/book/edit-edition-form.js"></script>
    <script src="~/assets/book/form-wizard.min.js"></script>

</body>
</html>





