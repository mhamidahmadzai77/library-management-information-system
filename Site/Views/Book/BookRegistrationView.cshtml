@{ if (Session["added"] != null)
    {
        if (Convert.ToBoolean(Session["added"]) == true)
        {
            Session["added"] = false;
            <script>
                swal("په بریاليتوب سره ثبت شو", "", {
                    icon: "success", buttons: "سمه ده"
                });
            </script>
        }
    }
}