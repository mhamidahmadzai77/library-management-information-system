        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د کتاب ډول : </label>
                        </div>
                        <div class="col-md-10">
                            @row.book_type
                        </div>
                    </div>
