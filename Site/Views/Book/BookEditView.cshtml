        </div>
        <div class="row" style="padding:20px 0 20px 0;">
            <div class="col-md-1"></div>
            <div class="col-md-11">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label class="control-label "> د وړنې اجازه : </label>
                        </div>
                        <div class="col-md-10">
                            @if (row.permission)
                            {
                                <span> نشته </span>
                            }
                            else
                            {
                                <span> شته </span>

                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="note note-success">
            <h4 class="form-section"> د هر جلد او چاپ معلومات</h4>
        </div>
        <div>
            <button type="button" onclick="showTab('tab4')" style="" class="btn  green fa-pull-right">
                <i class=""></i> نوی چاپ اضافه کړئ
            </button>
        </div>
        <div class="table-scrollable">
            <table class="table table-striped table-bordered table-hover" id="">
                <thead class="bg-blue-oleo bg-font-blue-oleo">
                    <tr>
                        <th> # </th>
                        <th> لرې کول </th>
                        <th> تغیر </th>
                        <th> جلد </th>
                        <th> چاپ </th>
                        <th> د تأسیس ځل </th>
                        <th> د تأسیس ځای </th>
                        <th style="min-width:100px;"> مطبعه </th>
                        <th> تعداد </th>
                        <th> موجوده تعداد </th>
                        <th> صفحې </th>
                        <th> CDs </th>
                        <th> د ثبت د تاریخ ډول </th>
                        <th> د ثبت کال </th>
                        <th> د ثبت میاشت </th>
                        <th> د ثبت ورځ </th>
                        <th> د چاپ د تاریخ ډول </th>
                        <th> د چاپ کال </th>
                        <th> د چاپ میاشت </th>
                        <th> د چاپ ورځ </th>
                        <th> د المارۍ نمبر </th>
                        <th> د خانې نمبر </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int No = 0;

                        foreach (var col in Model.QueryResults)
                        {
                            No++;
                            var btnDeleteId = "btnDelete" + No;
                            var btnEditId = "btnEdit" + No;

                            
                            var TDSegmentNo = "TDSegmentNo" + col.edition_id;
                            var TDEditionNo = "TDEditionNo" + col.edition_id;
                            var TDPublicationNo = "TDPublicationNo" + col.edition_id;
                            var TDPublicationPlace = "TDPublicationPlace" + col.edition_id;
                            var TDPublisherName = "TDPublisherName" + col.edition_id;
                            var TDPublicationQuantity = "TDPublicationQuantity" + col.edition_id;
                            var TDAvailableQuantity = "TDAvailableQuantity" + col.edition_id;
                            var TDPublicationPages = "TDPublicationPages" + col.edition_id;
                            var TDCDQuantity = "TDCDQuantity" + col.edition_id;
                            var TDRegistrationDateType = "TDRegistrationDateType" + col.edition_id;
                            var TDRegistrationYear = "TDRegistrationYear" + col.edition_id;
                            var TDRegistrationMonth = "TDRegistrationMonth" + col.edition_id;
                            var TDRegistrationDay = "TDRegistrationDay" + col.edition_id;
                            var TDPublicationDateType = "TDPublicationDateType" + col.edition_id;
                            var TDPublicationYear = "TDPublicationYear" + col.edition_id;
                            var TDPublicationMonth = "TDPublicationMonth" + col.edition_id;
                            var TDPublicationDay = "TDPublicationDay" + col.edition_id;
                            var TDCupboardNo = "TDCupboardNo" + col.edition_id;
                            var TDCellNo = "TDCellNo" + col.edition_id;
                            <tr>
                                <td style="text-align:center;"> @No </td>
                                <td style="text-align:center; color: red;" onmouseover="scaleDeleteButton(@No)" onmouseout="scaleDeleteButtonBack(@No)" onclick="DeleteEdition(@col.s_no,@col.segment_id,@col.edition_id)" class="btnDelete"> <i class="fa fa-trash" style="width:30px;" id="@btnDeleteId"></i> </td>
                                <td style="text-align:center; color: forestgreen;" onmouseover="scaleEditButton(@No)" onmouseout="scaleEditButtonBack(@No)" onclick='EditEdition(@col.s_no,@col.edition_id,@col.segment_id, @col.edition_no,@col.segment_no,@col.publication_no, "@col.publication_place", "@col.publisher_name",@col.publication_quantity,@col.publication_pages, @col.cd_quantity, "@col.publication_date_type", @col.publication_year, @col.publication_month, @col.publication_day, "@col.registration_date_type", @col.registration_year, @col.registration_month, @col.registration_day, @col.cupboard_no, @col.cell_no)' class="btnEdit"> <i class="fa fa-edit" style="width:30px;" id="@btnEditId"></i> </td>
                                <td style="text-align:center;" id="@TDSegmentNo">@col.segment_no</td>
                                <td style="text-align:center;" id="@TDEditionNo">@col.edition_no</td>
                                <td style="text-align:center;" id="@TDPublicationNo">@col.publication_no</td>
                                <td style="text-align:center;" id="@TDPublicationPlace">@col.publication_place</td>
                                <td style="text-align:center; min-width:100px;" id="@TDPublisherName">@col.publisher_name</td>
                                <td style="text-align:center;" id="@TDPublicationQuantity">@col.publication_quantity</td>
                                <td style="text-align:center;" id="@TDAvailableQuantity">@col.availableQuantity</td>
                                <td style="text-align:center;" id="@TDPublicationPages">@col.publication_pages</td>
                                <td style="text-align:center;" id="@TDCDQuantity">@col.cd_quantity</td>
                                <td style="text-align:center;" id="@TDRegistrationDateType">@col.registration_date_type</td>
                                <td style="text-align:center;" id="@TDRegistrationYear">@col.registration_year</td>
                                <td style="text-align:center;" id="@TDRegistrationMonth">@col.registration_month</td>
                                <td style="text-align:center;" id="@TDRegistrationDay">@col.registration_day</td>
                                <td style="text-align:center;" id="@TDPublicationDateType">@col.publication_date_type</td>
                                <td style="text-align:center;" id="@TDPublicationYear">@col.publication_year</td>
                                <td style="text-align:center;" id="@TDPublicationMonth">@col.publication_month</td>
                                <td style="text-align:center;" id="@TDPublicationDay">@col.publication_day</td>
                                <td style="text-align:center;" id="@TDCupboardNo">@col.cupboard_no</td>
                                <td style="text-align:center;" id="@TDCellNo">@col.cell_no</td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

    </div>

    <div id="tab2" class="tab-content">

        <div>
            <div class="note note-success">
                <h3 class="form-section">د کتاب د عمومي مشخصاتو د تغیرولو فورم.</h3>
            </div>
            <hr />
            <input type="hidden" id="s_no" value="@row.s_no" />
            <form class="form-horizontal" action="#" id="submit_form" method="POST">

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        د کتاب نړیوال نمبر
                    </label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="ISBN" id="ISBN" value="@row.ISBN" />
                        <span class="help-block"> د ISBN نمبر ولیکئ. </span>
                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        د کتاب دیوي نمبر
                    </label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="DDC" id="DDC" value="@row.DDC_classificationNo" />
                        <span class="help-block"> د DDC نمبر ولیکئ. </span>
                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        د کتاب کنګرس نمبر
                    </label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="LLC" id="LLC" value="@row.LLC_classificationNo" />
                        <span class="help-block"> د LLC نمبر ولیکئ.  </span>
                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        د کتاب نوم
                        <span class="required"> * </span>
                    </label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="name" id="name" value="@row.publication_name" />
                        <span class="help-block">  دکتاب نوم ولیکئ. </span>
                    </div>
                </div>


                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        د ژباړونکي نوم
                    </label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="translator" id="translator" value="@row.translator" />
                        <span class="help-block"> د ژباړونکي نوم ولیکئ.  </span>
                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        شعبه
                        <span class="required"> * </span>
                    </label>
                    <div class="col-md-6 ">
                        <select name="branch" id="branch" class="form-control ">
                            @foreach (var branch in ViewBag.branch)
                            {
                                if (branch.branch_name == row.branch)
                                {
                                    <option selected value="@branch.branch_id">@branch.branch_name</option>
                                }
                                else
                                {
                                    <option value="@branch.branch_id">@branch.branch_name</option>
                                }

                            }
                        </select>
                        <span class="help-block"> شعبه انتخاب کړئ  </span>
                    </div>
                </div>
                <div class="col-md-1"></div>
                <div class="form-group ">
                    <label class="control-label col-md-2">
                        د کتاب ډول
                        <span class="required"> * </span>
                    </label>
                    <div class="col-md-6">
                        <select name="bookType" id="bookType" class="form-control select bootstrap-select">
                            <option value="Text Book">Text Book</option>
                            <option value="Reference Book">Reference Book</option>
                            <option value="Peotry">Peotry</option>
                            <option value="Novel">Novel</option>
                            <option value="Biography">Biography</option>
                            <option value="Art and Photography">Art and Photography</option>
                            <option value="Spanish">Spanish</option>
                            <option selected value="@row.book_type">@row.book_type</option>
                        </select>
                        <span class="help-block">  د کتاب ډول انتخاب کړئ. </span>
                    </div>
                </div>
                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        ژبه
                        <span class="required"> * </span>
                    </label>
                    <div class="col-md-6">
                        <select name="language" id="language" class="form-control select bootstrap-select">
                            <option value="پښتو">پښتو</option>
                            <option value="دری">دری</option>
                            <option value="فارسی">فارسی</option>
                            <option value="English">English</option>
                            <option value="عربی">عربی</option>
                            <option value="اردو">اردو</option>
                            <option value="Spanish">Spanish</option>
                            <option selected value="@row.publication_language">@row.publication_language</option>
                        </select>
                        <span class="help-block">  د کتاب ژبه انتخاب کړئ. </span>
                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        اضافه معلومات
                    </label>
                    <div class="col-md-6">
                        <textarea class="form-control" rows="3" name="description" id="description">@row.publication_description</textarea>
                        <span class="help-block">  کتاب په اړه نور معلومات ولیکئ.  </span>
                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group ">
                    <label class="control-label col-md-2">لیکوالان</label>
                    <div class="input-group select2-bootstrap-prepend col-md-6">

                        <select id="select2-disabled-inputs-multiple" name="authors" class="form-control select2-multiple" multiple>
                            @{
                                string[] authorIdParts = BookController.authorIds.Split(',');
                                int totalAuthors = authorIdParts.Length - 1;
                                long id = 0;
                                foreach (var author in ViewBag.author)
                                {
                                    id = 0;
                                    for (int i = 0; i < totalAuthors; i++)
                                    {
                                        if (int.Parse(authorIdParts[i]) == author.author_id)
                                        {
                                            id = author.author_id;
                                            break;
                                        }
                                    }

                                    if (id > 0)
                                    {
                                        <option selected value="@author.author_id">@author.author_firstname @author.author_lastname</option>
                                    }
                                    else
                                    {
                                        <option value="@author.author_id">@author.author_firstname @author.author_lastname</option>
                                    }

                                    //<option value="@author.author_id">@author.author_firstname @author.author_lastname</option>



                                }

                            }

                        </select>
                        <span class="help-block" id="lableAuthor">  د لیکوالانو نومونه انتخاب کړئ </span>

                    </div>
                </div>

                <div class="col-md-1"></div>
                <div class="form-group">
                    <label class="control-label col-md-2">
                        د وړنې اجازه
                    </label>
                    <div class="col-md-6">
                        <div class="portlet light form-fit " style="margin-left:-5%;">
                            <div class="portlet-title">
                                <div class="actions">
                                    @if (row.permission == true)
                                    {
                                        <input type="checkbox" id="referenceBook" class="make-switch" data-on="success" data-on-color="success" data-off-color="danger" data-size="small">
                                    }
