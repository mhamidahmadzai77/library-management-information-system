<html>
<head>

</head>
<body>

    <div class="note note-success">

        <h3 style="color: gray; font-weight:bold; text-align:center;"> د استاد د ثبت فورم</h3>
    </div>

    <div>
        <form>
            <div class="row">
                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">تذکري نمبر</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_idcardnumber" id="teacher_idcardnumber" style="border-radius:6px;" placeholder="تذکري نمبر" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">نوم</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_name" id="teacher_name" style="border-radius:6px;" placeholder="نوم" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">تخلص</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_lastname" id="teacher_lastname" style="border-radius:6px;" placeholder="تخلص" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">پلار نوم</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_fathername" id="teacher_fathername" style="border-radius:6px;" placeholder="پلار نوم" />
                        <br />

                    </div>

                </div>

               

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">جنس</label>

                    </div>

                    <div class=" col-md-6">

                        <select class="form-control" style="padding:5px; border-radius:6px;" id="teacher_gender">

                            <option style="font-size:24px;" value="نارینه">نارینه </option>
                            <option style="font-size:24px;" value="ښځینه">ښځینه </option>

                        </select>
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">پوهنتون</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_university" id="teacher_university" style="border-radius:6px;" placeholder="پوهنتون" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">پوهنځی</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_faculty" id="teacher_faculty" style="border-radius:6px;" placeholder="پوهنځی" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">څانګه</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="teacher_department" id="teacher_department" style="border-radius:6px;" placeholder="څانګه" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">تیلیفون شماره</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="number" class="form-control col-md-6" name="teacher_phonenumber" id="teacher_phonenumber" style="border-radius:6px;" placeholder="تلیفون شماره" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">ایمیل</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="email" class="form-control col-md-6" name="teacher_email" id="teacher_email" style="border-radius:6px;" placeholder="ایمیل" />
                        <br />

                    </div>

                </div>
                <div class="col-md-8">
                    <button type="button" class="btn green mt-ladda-btn ladda-button btn-outline pull-right" data-style="slide-down" data-spinner-color="#333" style="padding:6px 20px 6px 20px;" onclick="submitForm()">
                        <span class="ladda-label">
                            <i id="icon" class="fa fa-save"></i> ثبتول
                        </span>
                        <span class="ladda-spinner"></span>
                    </button>
                </div>

            </div>
        </form>
    </div>




    <script type="text/javascript">

        function Empty() {
            var idcardnumber = document.getElementById("teacher_idcardnumber");
            var teacher_firstname = document.getElementById("teacher_name");
            var teacher_lastname = document.getElementById("teacher_lastname");
            var teacher_fathername = document.getElementById("teacher_fathername");
           
            var teacher_gender = document.getElementById("teacher_gender");
            var teacher_university = document.getElementById("teacher_university");
            var teacher_faculty = document.getElementById("teacher_faculty");
            var teacher_department = document.getElementById("teacher_department");
            var teacher_phonenumber = document.getElementById("teacher_phonenumber");
            var teacher_email = document.getElementById("teacher_email");
            idcardnumber.value = "";
            teacher_firstname.value = "";
            teacher_lastname.value = "";
            teacher_fathername.value = "";
           
            teacher_gender.value = "";
            teacher_university.value = "";
            teacher_faculty.value = "";
            teacher_faculty.value = "";
            teacher_department.value = "";
            teacher_phonenumber.value = "";
            teacher_email.value = "";
        }

        function submitForm() {
            event.preventDefault();
            var teacher_idcardnumber = document.getElementById("teacher_idcardnumber").value;
            var teacher_firstname = document.getElementById("teacher_name").value;
            var teacher_lastname = document.getElementById("teacher_lastname").value;
            var teacher_fathername = document.getElementById("teacher_fathername").value;
            
            var teacher_gender = document.getElementById("teacher_gender").value;
            var teacher_university = document.getElementById("teacher_university").value;
            var teacher_faculty = document.getElementById("teacher_faculty").value;
            var teacher_department = document.getElementById("teacher_department").value;
            var teacher_phonenumber = document.getElementById("teacher_phonenumber").value;
            var teacher_email = document.getElementById("teacher_email").value;


            var emailPatteren = new RegExp("^[^\\s]+" + String.fromCharCode(64) + "[^\\s]+\\.[^\\s]+$");

            if (teacher_idcardnumber == "") {
                document.getElementById("teacher_idcardnumber").style.border = "1px solid red";
                document.getElementById("teacher_idcardnumber").focus();
            }
            else if (teacher_firstname == "") {
                document.getElementById("teacher_name").style.border = "1px solid red";
                document.getElementById("teacher_name").focus();
            }
            else if (/^\d+$/.test(teacher_firstname)) {
                swal(" استاد نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_name").style.border = "1px solid red";
                document.getElementById("teacher_name").focus();
            }
            else if (teacher_lastname == "") {
                document.getElementById("teacher_lastname").style.border = "1px solid red";
                document.getElementById("teacher_lastname").focus();
            }
            else if (/^\d+$/.test(teacher_lastname)) {
                swal(" تخلص صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_lastname").style.border = "1px solid red";
                document.getElementById("teacher_lastname").focus();
            }
            else if (teacher_fathername == "") {
                document.getElementById("teacher_fathername").style.border = "1px solid red";
                document.getElementById("teacher_fathername").focus();
            }
            else if (/^\d+$/.test(teacher_fathername)) {
                swal("د پلار نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_fathername").style.border = "1px solid red";
                document.getElementById("teacher_fathername").focus();
            }
           
            
            else if (teacher_gender == "") {
                document.getElementById("teacher_gender").style.border = "1px solid red";
                document.getElementById("teacher_gender").focus();
            }
            else if (teacher_university == "") {
                document.getElementById("teacher_university").style.border = "1px solid red";
                document.getElementById("teacher_university").focus();
            }
            else if (/^\d+$/.test(teacher_university)) {
                swal("د پوهنتون نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_university").style.border = "1px solid red";
                document.getElementById("teacher_university").focus();
            }
            else if (teacher_faculty == "") {
                document.getElementById("teacher_faculty").style.border = "1px solid red";
                document.getElementById("teacher_faculty").focus();
            }
            else if (/^\d+$/.test(teacher_faculty)) {
                swal("د پوهنځي نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_faculty").style.border = "1px solid red";
                document.getElementById("teacher_faculty").focus();
            }
            else if (teacher_department == "") {
                document.getElementById("teacher_department").style.border = "1px solid red";
                document.getElementById("teacher_department").focus();
            }
            else if (/^\d+$/.test(teacher_department)) {
                swal("د څانګي نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_department").style.border = "1px solid red";
                document.getElementById("teacher_department").focus();
            }
            else if (teacher_phonenumber == "") {
                document.getElementById("teacher_phonenumber").style.border = "1px solid red";
                document.getElementById("teacher_phonenumber").focus();
            }
            else if(!((teacher_phonenumber.startsWith("07") && teacher_phonenumber.length ===10) || (teacher_phonenumber.startsWith("0093") && teacher_phonenumber.length === 13))) {
                swal("صحي شماره ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_phonenumber").style.border = "1px solid red";
                document.getElementById("teacher_phonenumber").focus();
            }
            
            else if (teacher_email != "" && !emailPatteren.test(teacher_email) ) {
                swal("صحي ایمیل ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("teacher_email").style.border = "1px solid red";
                document.getElementById("teacher_email").focus();
            }


            else {

                   var data = {
                       person_idCard: teacher_idcardnumber,
                       person_firstname:teacher_firstname,
                       person_lastname:teacher_lastname,
                       person_father_name:teacher_fathername,
                       person_state:'teacher',
                       gender: teacher_gender,
                       university:teacher_university,
                       faculty: teacher_faculty,
                       department:teacher_department,
                       phone_number:teacher_phonenumber,
                       email: teacher_email
                   };

                $.ajax({
                    url: "/Person/TeacherRegistration",
                    type: "post",
                    data: data,
                    success: function (response) {
                        if (response == true) {
                            swal("په بریالیتوب سره معلومات ثبت شول.", "", {
                                icon: "success",
                                buttons: "سمه ده"
                               
                            });
                            Empty();
                        }
                        else {
                            swal("ستونزه رامنځته شوه", "", {
                                icon: "error",
                                buttons: "سمه ده"
                               
                            });
                            Empty();
                        }
                    },
                    error: function (error) {
                        swal("ستونزه رامنځته شوه", "", {
                            icon: "error",
                            buttons: "سمه ده"

                        });
                    }
                });

                 }



        }

    </script>
    <script src="~/assets/alert.js"></script>
</body>
</html>
