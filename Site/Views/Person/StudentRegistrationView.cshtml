<html>
<head>

</head>
<body>

    <div class="note note-success">

        <h3 style="color: gray; font-weight:bold; text-align:center;"> د محصل د ثبت فورم</h3>
    </div>

    <div>
        <form>
            <div class="row">
                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">تذکري نمبر</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_idcardnumber" id="student_idcardnumber" style="border-radius:6px;" placeholder="تذکري نمبر" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">نوم</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_name" id="student_name" style="border-radius:6px;" placeholder="نوم" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">تخلص</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_lastname" id="student_lastname" style="border-radius:6px;" placeholder="تخلص" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">پلار نوم</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_fathername" id="student_fathername" style="border-radius:6px;" placeholder="پلار نوم" />
                        <br />

                    </div>

                </div>

                

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">جنس</label>

                    </div>

                    <div class=" col-md-6">

                        <select class="form-control" style="padding:5px; border-radius:6px;" id="student_gender">

                            <option style="font-size:24px;" value="نارینه">نارینه </option>
                            <option style="font-size:24px;" value="ښځینه">ښځینه </option>

                        </select>
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">پوهنتون</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_university" id="student_university" style="border-radius:6px;" placeholder="پوهنتون" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">پوهنځی</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_faculty" id="student_faculty" style="border-radius:6px;" placeholder="پوهنځی" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">څانګه</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control col-md-6" name="student_department" id="student_department" style="border-radius:6px;" placeholder="څانګه" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">سمستر</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="number" class="form-control col-md-6" name="student_semester" id="student_semester" style="border-radius:6px;" placeholder="سمستر" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">تیلیفون شماره</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="number" class="form-control col-md-6" name="student_phonenumber" id="student_phonenumber" style="border-radius:6px;" placeholder="تلیفون شماره" />
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:20px">ایمیل</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="email" class="form-control col-md-6" name="student_email" id="student_email" style="border-radius:6px;" placeholder="ایمیل" />
                        <br />

                    </div>

                </div>
                <div class="col-md-8">
                    <button type="button" class="btn green mt-ladda-btn ladda-button btn-outline pull-right" data-style="slide-down" data-spinner-color="#333" style="padding:6px 20px 6px 20px;" onclick="submitForm()">
                        <span class="ladda-label">
                            <i id="icon" class="fa fa-save"></i> ثبتول
                        </span>
                        <span class="ladda-spinner"></span>
                    </button>
                </div>

            </div>
        </form>
    </div>



    <script type="text/javascript">

        function Empty() {
            var student_idcardnumber = document.getElementById("student_idcardnumber");
            student_idcardnumber.value = "";
            var student_firstname = document.getElementById("student_name");
            student_firstname.value = "";
            var student_lastname = document.getElementById("student_lastname");
            student_lastname.value = "";
            var student_fathername = document.getElementById("student_fathername");
            student_fathername.value = "";
            
            var student_gender = document.getElementById("student_gender");
            student_gender.value = "";
            var student_university = document.getElementById("student_university");
            student_university.value = "";
            var student_faculty = document.getElementById("student_faculty");
            student_faculty.value= "";

            var student_department = document.getElementById("student_department");
            student_department.value = "";
            var student_semester = document.getElementById("student_semester");
            student_semester.value = "";
            var student_phonenumber = document.getElementById("student_phonenumber");
            student_phonenumber.value = "";
            var student_email = document.getElementById("student_email");
            student_email.value = "";
        }

        function submitForm() {
            event.preventDefault();
            var student_idcardnumber = document.getElementById("student_idcardnumber").value;
            var student_firstname = document.getElementById("student_name").value;
            var student_lastname = document.getElementById("student_lastname").value;
            var student_fathername = document.getElementById("student_fathername").value;
          
            var student_gender = document.getElementById("student_gender").value;
            var student_university = document.getElementById("student_university").value;
            var student_faculty = document.getElementById("student_faculty").value;
            var student_department = document.getElementById("student_department").value;
            var student_semester = document.getElementById("student_semester").value;


            var student_phonenumber = document.getElementById("student_phonenumber").value;
            var student_email = document.getElementById("student_email").value;
            var emailPatteren = new RegExp("^[^\\s]+" + String.fromCharCode(64) + "[^\\s]+\\.[^\\s]+$");
            if (student_idcardnumber == "") {
                document.getElementById("student_idcardnumber").style.border = "1px solid red";
                document.getElementById("student_idcardnumber").focus();
            }
            else if (student_firstname == "") {
                document.getElementById("student_name").style.border = "1px solid red";
                document.getElementById("student_name").focus();
            }
            else if (/^\d+$/.test(student_firstname)) {
                swal(" محصل نوم صحیح ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_name").style.border = "1px solid red";
                document.getElementById("student_name").focus();
            }
            else if (student_lastname == "") {
                document.getElementById("student_lastname").style.border = "1px solid red";
                document.getElementById("student_lastname").focus();
            }
            else if (/^\d+$/.test(student_lastname)) {
                swal(" محصل تخلص صحیح ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_lastname").style.border = "1px solid red";
                document.getElementById("student_lastname").focus();
            }
            else if (student_fathername == "") {
                document.getElementById("student_fathername").style.border = "1px solid red";
                document.getElementById("student_fathername").focus();
            }
            else if (/^\d+$/.test(student_fathername)) {
                swal("د پلار نوم صحیح ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_fathername").style.border = "1px solid red";
                document.getElementById("student_fathername").focus();
            }
            
            else if (student_gender == "") {
                document.getElementById("student_gender").style.border = "1px solid red";
                document.getElementById("student_gender").focus();
            }
            else if (student_university == "") {
                document.getElementById("student_university").style.border = "1px solid red";
                document.getElementById("student_university").focus();
            }
            else if (/^\d+$/.test(student_university)) {
                swal("د پوهنتون نوم صحیح ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_university").style.border = "1px solid red";
                document.getElementById("student_university").focus();
            }
            else if (student_faculty == "") {
                document.getElementById("student_faculty").style.border = "1px solid red";
                document.getElementById("student_faculty").focus();
            }
            else if (/^\d+$/.test(student_faculty)) {
                swal("د پوهنځي نوم صحیح ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_faculty").style.border = "1px solid red";
                document.getElementById("student_faculty").focus();
            }
            else if (student_department == "") {
                document.getElementById("student_department").style.border = "1px solid red";
                document.getElementById("student_department").focus();
            }
            else if (/^\d+$/.test(student_department)) {
                swal("د څانګي نوم صحیح ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_department").style.border = "1px solid red";
                document.getElementById("student_department").focus();
            }
            else if (student_semester == "" || student_semester < 1 || student_semester > 12) {
                document.getElementById("student_semester").style.border = "1px solid red";
                document.getElementById("student_semester").focus();

            }
                
            else if (student_phonenumber == "") {
                document.getElementById("student_phonenumber").style.border = "1px solid red";
                document.getElementById("student_phonenumber").focus();
            }
            else if (!((student_phonenumber.startsWith("07") && student_phonenumber.length === 10) || (student_phonenumber.startsWith("0093") && student_phonenumber.length === 13))) {
                swal("صحیح شماره ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_phonenumber").style.border = "1px solid red";
                document.getElementById("student_phonenumber").focus();
            }
            else if ((student_email != "" && !emailPatteren.test(student_email))){
                swal("صحیح ایمیل ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("student_email").style.border = "1px solid red";
                document.getElementById("student_email").focus();
            }
            else {
               
                var PersonDetails = {
                    person_idCard: student_idcardnumber,
                    person_firstname: student_firstname,
                    person_lastname: student_lastname,
                    person_father_name: student_fathername,
                    person_state:'student',
                    gender: student_gender,
                    university: student_university,
                    faculty: student_faculty,
                    department: student_department,
                    phone_number: student_phonenumber,
                    email: student_email
                };
                var StudentDetails = {
                   
                    semester: student_semester
                };

                $.ajax({
                    url: "/Person/StudentRegistration",
                    type: "post",
                    data: { personDetails: PersonDetails, studentDetails: StudentDetails },
                    success: function (response) {
                        if (response == true) {
                            swal("په بریالیتوب سره معلومات ثبت شول.", "", {
                                icon: "success",
                                buttons: "سمه ده"

                            });
                            Empty();
                        }
                        else {
                            swal("ستونزه رامنځته شوه", "", {
                                icon: "error",
                                buttons: "سمه ده"

                            });
                        }

                    },
                    error: function (err) {

                        swal("ستونزه رامنځته شوه", "", {
                            icon: "error",
                            buttons: "سمه ده"

                        });
                    }
                });
            }
        }

    </script>
    <script src="~/assets/alert.js"></script>
</body>
</html>
