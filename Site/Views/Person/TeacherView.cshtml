@using Site.Controllers
@model IEnumerable<Site.Models.Person>

<html>
<head>
    <title></title>
</head>
<body>

    <div class="row">

        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet box green">
                <div class="portlet-title">
                    <div class="caption" style="color:aqua;  font-size:25px;">
                        د استادانو لیست
                    </div>
                    <div class="tools"> </div>
                </div>

                <div class="portlet-body">

                    <table class="table table-striped table-bordered table-hover" id="sample_2">
                        <thead>
                            <tr>
                                <th> شماره</th>
                                <th> تذکري نمبر </th>
                                <th>نوم </th>
                                <th> تخلص </th>
                                <th> پلار نوم </th>
                               
                                <th> جنس </th>
                                <th> پوهنتون </th>
                                <th> پوهنځی </th>
                                <th> څانګه </th>
                                <th> تیلیفون نمبر </th>
                                <th> ایمیل </th>
                                <th>عمل</th>

                            </tr>
                        </thead>
                        <tbody>
                          @{ 
                              var number = 1;
                              var idcardIdTdId = "";
                              var nameIdTdId = "";
                              var lastnameIdTdId = "";
                              var fatherIdTdId = "";
                             
                              var genderIdTdId = "";
                              var universityIdTdId = "";
                              var facultyIdTdId = "";
                              var departmentIdTdId = "";
                              var phoneIdTdId = "";
                              var emailIdTdId = "";
                              foreach(var item in Model)
                              {
                                  idcardIdTdId = "idcardIdTdId" + item.person_id;
                                  nameIdTdId = "nameIdTdId" + item.person_id;
                                  lastnameIdTdId = "lastnameIdTdId" + item.person_id;
                                  fatherIdTdId = "fatherIdTdId" + item.person_id;
                                 
                                  genderIdTdId = "genderIdTdId" + item.person_id;
                                  universityIdTdId = "universityIdTdId" + item.person_id;
                                  facultyIdTdId = "facultyIdTdId" + item.person_id;
                                  departmentIdTdId = "departmentIdTdId" + item.person_id;
                                  phoneIdTdId = "phoneIdTdId" + item.person_id;
                                  emailIdTdId = "emailIdTdId" + item.person_id;

                                  <tr id="@item.person_id">
                                      <td id="@item.person_id">@number</td>
                                      <td id="idcardIdTdId">@item.person_idCard</td>
                                      <td id="nameIdTdId">@item.person_firstname</td>
                                      <td id="lastnameIdTdId">@item.person_lastname</td>
                                      <td id="fatherIdTdId">@item.person_father_name</td>
                                     
                                      <td id="genderIdTdId">@item.gender</td>
                                      <td id="universityIdTdId">@item.university</td>
                                      <td id="facultyIdTdId">@item.faculty</td>
                                      <td id="departmentIdTdId">@item.department</td>
                                      <td id="phoneIdTdId">@item.phone_number</td>
                                      <td id="emailIdTdId">@item.email</td>
                                      <td>
                                          <a href="/Person/TeacherEditView/@item.person_id"  class="btn green mt-ladda-btn ladda-button btn-outline" data-style="slide-down" data-spinner-color="#333">
                                              <span class="ladda-label">
                                                  <i class="fa fa-edit"></i> تغیرات
                                              </span>
                                              <span class="ladda-spinner"></span>
                                          </a>
                                          
                                          <button  type="button" class="btn red mt-ladda-btn ladda-button btn-outline" data-style="slide-down" data-spinner-color="#333" onclick="DeleteRecord(@item.person_id)">
                                              <span class="ladda-label">
                                                  <i class="fa fa-trash"></i> حذف
                                              </span>
                                              <span class="ladda-spinner"></span>
                                          </button>
                                      </td>
                                  </tr>

                                  number++;

                              }
                          }
                        </tbody>

                    </table>


                </div>

            </div>
            <!-- END EXAMPLE TABLE PORTLET-->

        </div>

    </div>

    <script type="text/javascript">

        function DeleteRecord(id) {
            swal({
                title: "ایا تاسو ډاډه یاست؟",
                text: "یو ځل چې معلومات له منځه لاړل د بیا ځل لپاره یې نشئ ترلاسه کولی!",
                icon: "warning",
                buttons: ["نه", "هو"]
                ,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        // If user clicked yes button

                        $.ajax({
                            type: 'POST',
                            url: '/Person/TeacherDelete',
                            data: { id: id },
                            success: function (response) {
                                if (response == true) {

                                    
                                    swal("په بریالیتوب سره معلومات له سېسټم څخه لرې شو.","", {
                                        icon: "success",
                                        buttons: "سمه ده",
                                        url:"Person/PersonView"

                                    });
                                    const elementToRemove = document.getElementById('' + id);

                                    elementToRemove.remove();

                                }
                                else if (response == false) {
                                    swal("ستونزه رامنځته شوه", "", {
                                        icon: "error",
                                        buttons: "سمه ده"
                                    });
                                }
                                else {
                                    swal("ستونزه رامنځته شوه", "Exception: " + response.responseText, {
                                        icon: "error",
                                        buttons: "سمه ده"
                                    });
                                }


                            },
                            error: function (error) {
                                swal("ستونزه رامنځته شوه", "Error: " + error.responseText, {
                                    icon: "error",
                                    buttons: "سمه ده"
                                });
                            }
                        });


                    } else {
                        swal("معلومات خوندي پاتې شول!","", { icon: "info", buttons: "سمه ده" });
                    }
                });
        }


    </script>
    <script src="~/assets/alert.js"></script>
</body>
</html>
