<!-- END HEAD -->

<body>
    <div>
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <a class="dashboard-stat dashboard-stat-v2 blue" href="@Url.Action("NotReturnedBook")">
                    <div style="height:100px;"></div>
                    <div class="visual">
                        <i class="fa fa-shopping-cart"></i>
                    </div>
                    <div class="details">
                        <div class="number">
                            <span> باقیداره مراجعین راپور </span>
                        </div>
                        <div></div>
                        <div class="desc"> د هغو مراجعینو راپور چې کتابونه یې وړي اما بېرته یې ندي راوړي </div>
                    </div>
                    <div style="height:200px;"></div>
                </a>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <a class="dashboard-stat dashboard-stat-v2 purple" href="@Url.Action("TotalPublicatoinReport")">
                    <div style="height:100px;"></div>
                    <div class="visual">
                        <i class="fa fa-globe"></i>
                    </div>
                    <div class="details">
                        <div class="number">
                            <span> د کتابتون راپور </span>
                        </div>
                        <div></div>
                        <div class="desc"> د ټولو کتابونو، مجلو، تېزس او مونوګرافونو معلوماتي راپور </div>
                    </div>
                    <div style="height:200px;"></div>
                </a>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <a class="dashboard-stat dashboard-stat-v2 red" href="@Url.Action("BranchVoiceReport")">
                    <div style="height:100px;"></div>
                    <div class="visual">
                        <i class="fa fa-bar-chart-o"></i>
                    </div>
                    <div class="details">
                        <div class="number">
                            <span> د شعبو راپور </span>
                        </div>
                        <div></div>
                        <div class="desc"> دا راپور د شعبو په اساس دی چې په هره شعبه کې څومره کتابونه موجود دي </div>
                    </div>
                    <div style="height:200px;"></div>
                </a>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <a class="dashboard-stat dashboard-stat-v2 green" href="@Url.Action("NewspaperReport")">
                    <div style="height:100px;"></div>
                    <div class="visual">
                        <i class="fa fa-comments"></i>
                    </div>
                    <div class="details">
                        <div class="number">
                            <span> د اخبارونو راپور </span>
                        </div>
                        <div></div>
                        <div class="desc"> د هرې خبر پاڼې مجموعي تعداد راپور </div>
                    </div>
                    <div style="height:200px;"></div>
                </a>
            </div>

        </div>
    </div>
    <noscript>
        <iframe src="http://www.googletagmanager.com/ns.html?id=GTM-NGFVTN"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
