@model Site.Models.PublicationQueryResultModel

@{
    if (Session["user"] != null)
    {
        if (Session["user"].ToString() == "authenticated")
        {
            if (Session["level"].ToString() == "admin")
            {
                Layout = "~/Views/Shared/_AdminLayout.cshtml";
            }
            if (Session["level"].ToString() == "director")
            {
                Layout = "~/Views/Shared/_UserLayout.cshtml";
            }
        }
        else if (Session["user"].ToString() == "locked")
        {
            // Redirect to lock sreen page using javascript
            <script>
                    window.location.href = '@Url.Action("LockScreen","User")';
            </script>
        }

    }
    else
    {
        <script>
            window.location.href = '@Url.Action("LoginView","User")';
        </script>
    }

}

<html lang="en">
<head>
    <title></title>


    <meta charset="utf-8" />
    <meta name="viewport" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />

    <script src="~/assets/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>


    <style>
        .tab-content {
            display: none;
        }

        #tab1 {
            display: block;
        }

        .btnDelete:hover {
            cursor: pointer;
        }

        .btnEdit:hover {
            cursor: pointer;
        }
    </style>

</head>
<body>
    <div class="alert alert-danger display-none" id="alert-danger" style="display: none;">
        <button class="close" data-dismiss="alert"></button> ستاسو په فورم کې مشکل دی. مهرباني وکړئ سم معلومات داخل کړئ.
    </div>
    <div id="tab1" class="tab-content" style="padding-bottom:50px;">

        <div class="note note-success" style="text-align:center;background-color:;">
            <h1 class="form-section"> شخص ته د کتاب د ورکولو فورم</h1>
        </div>
        <hr />
        <input type="hidden" id="personId" value="" />
        <input type="hidden" id="editionId" value="" />
        <div class="row">
            <div class="form-group">
                <div class="col-md-1"></div>
                <label class="control-label col-md-2">
                    د شخص نوم<span style="color:red;" class="pull-right">*</span>
                </label>
                <div class="col-md-5">
                    <input type="text" class="form-control" disabled name="personName" id="personName" />
                    <span class="help-block"> د شخص نوم انتخاب کړئ. </span>
                </div>
                <div class="col-md-1 ">
                    <input type="button" class="form-control" onclick="showTab('tab3')" name="name" value="انتخاب" />
                </div>

            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-md-1"></div>
                <label class="control-label col-md-2">
                    کتاب<span style="color:red;" class="pull-right">*</span>
                </label>
                <div class="col-md-5">
                    <input type="text" class="form-control" name="publicationName" disabled id="publicationName" />
                    <span class="help-block"> کتاب انتخاب کړئ. </span>
                </div>
                <div class="col-md-1 ">
                    <input type="button" class="form-control col-md-1" onclick="showTab('tab2')" name="name" value="انتخاب" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-md-1"></div>
                <label class="control-label col-md-2">
                    د وړلو نېټه<span style="color:red;" class="pull-right">*</span>
                </label>
                <div class="col-md-6">
                    <input type="date" class="form-control" name="issueDate" id="issueDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span class="help-block"> د وړلو نېټه وټاکئ. </span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-md-1"></div>
                <label class="control-label col-md-2">
                    د تسلیمولو وروستۍ نېټه<span style="color:red;" class="pull-right">*</span>
                </label>
                <div class="col-md-6">
                    <input type="date" class="form-control" name="returnDate" id="returnDate" value="@DateTime.Now.AddDays(3).ToString("yyyy-MM-dd")" />
                    <span class="help-block"> د تسلیمولو وروستۍ نېټه وټاکئ. </span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-md-1"></div>
                <label class="control-label col-md-2">
                    افغانۍ
                </label>
                <div class="col-md-6">
                    <input type="number" value="0" class="form-control" name="paidMoney" id="paidMoney" />
                    <span class="help-block"> افغانۍ داخل کړئ </span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <label class="control-label col-md-3"></label>
                <div class="col-md-6">
                    <div class="pull-right">
                        <button type="button" onclick="saveDealing()" class="btn btn-outline green icon-check " name="" id="" style="width:100px;"> ثبت </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="tab2" class="tab-content">

        <div>
            <div class="row">
                <div class="col-md-12">
                    <!-- BEGIN EXAMPLE TABLE PORTLET-->
                    <div class="portlet box green">
                        <div class="portlet-title">
                            <div class="caption">
                                <i class="icon-layers"></i> کتاب انتخاب کړئ
                            </div>
                            <div class="tools"> </div>
                        </div>
                        <div class="portlet-body">
                            <table class="table table-striped table-bordered table-hover" id="sample_2">
                                <thead>
                                    <tr>
                                        <th> شماره</th>
                                        <th>د کتاب کوډ</th>
                                        <th>د کتاب نوم</th>
                                        <th>لیکوال|لیکوالان</th>
                                        <th>د تآسیس ډول</th>
                                        <th>جلد نمبر</th>
                                        <th>چاپ</th>
                                        <th>موجوده تعداد</th>
                                        <th style="text-align:center;">انتخاب کړئ</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int number = 1;


                                        foreach (var item in Model.QueryResults)
                                        {

                                            var availableQuantityId = "availableQuantityId" + item.edition_id;
                                            var btnSelectId = "btnSelectId" + item.edition_id;

                                            <tr id="@item.edition_id">
                                                @*BEGIN COL 1*@
                                                <td> @number </td>
                                                @*END COL 1*@

                                                @*BEGIN COL 2*@

                                                <td> @item.edition_id </td>
                                                @*END COL 2*@

                                                @*BEGIN COL 3*@
                                                <td> @item.publication_name </td>
                                                @*END COL 3*@

                                                @*BEGIN COL 4*@

                                                <td>@item.authors</td>
                                                @*END COL 4*@
                                                @*BEGIN COL 5*@

                                                <td> @item.publication_type </td>
                                                @*END COL 5*@

                                                @*BEGIN COL 6*@
                                                <td> @item.segment_no </td>
                                                @*END COL 6*@

                                                @*BEGIN COL 7*@
                                                <td> @item.edition_no </td>
                                                @*END COL 7*@

                                                @*BEGIN COL 8*@
                                                <td id="@availableQuantityId"> @item.availableQuantity </td>
                                                @*END COL 8*@

                                                @*BEGIN COL 9*@
                                                @{
                                                    if (item.availableQuantity > 0)
                                                    {
                                                        <td style="text-align:center;">
                                                            <button id="@btnSelectId" onclick='selectPublication(@item.edition_id,"@item.publication_name")' class="btn green mt-ladda-btn ladda-button " data-style="slide-down" data-spinner-color="#333">
                                                                <span class="ladda-label">
                                                                    <i class="icon-check"></i> انتخاب
                                                                </span>
                                                                <span class="ladda-spinner"></span>
                                                            </button>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td style="text-align:center;">
                                                            <button disabled class="btn green mt-ladda-btn ladda-button " data-style="slide-down" data-spinner-color="#333">
                                                                <span class="ladda-label">
                                                                    <i class="icon-check"></i> انتخاب
                                                                </span>
                                                                <span class="ladda-spinner"></span>
                                                            </button>
                                                        </td>
                                                    }

                                                }

                                                @*END COL 9*@


                                            </tr>
                                            number++;
                                        }


                                    }



                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- END EXAMPLE TABLE PORTLET-->
                </div>
            </div>
        </div>
    </div>
    <div id="tab3" class="tab-content">
        <div class="row">

            <div class="col-md-12">
                <!-- BEGIN EXAMPLE TABLE PORTLET-->
                <div class="portlet box green">
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="icon-layers"></i> مراجعین
                        </div>
                        <div class="tools"> </div>
                    </div>

                    <div class="portlet-body">

                        <table class="table table-striped table-bordered table-hover" id="sample_1">
                            <thead>
                                <tr>
                                    <th> شماره</th>
                                    <th> تذکري نمبر </th>
                                    <th>نوم </th>
                                    <th> تخلص </th>
                                    <th> پلار نوم </th>
                                    <th> جنسیت </th>
                                    <th> پوهنتون </th>
                                    <th> پوهنځی </th>
                                    <th> څانګه </th>
                                    <th> تیلیفون نمبر </th>
                                    <th> ایمیل </th>
                                    <th style="text-align:center;">انتخاب کړئ</th>

                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    number = 1;
                                    var idcardIdTdId = "";
                                    var nameIdTdId = "";
                                    var lastnameIdTdId = "";
                                    var fatherIdTdId = "";

                                    var genderIdTdId = "";
                                    var universityIdTdId = "";
                                    var facultyIdTdId = "";
                                    var departmentIdTdId = "";
                                    var phoneIdTdId = "";
                                    var emailIdTdId = "";
                                    foreach (var item in ViewBag.Person)
                                    {
                                        idcardIdTdId = "idcardIdTdId" + item.person_id;
                                        nameIdTdId = "nameIdTdId" + item.person_id;
                                        lastnameIdTdId = "lastnameIdTdId" + item.person_id;
                                        fatherIdTdId = "fatherIdTdId" + item.person_id;

                                        genderIdTdId = "genderIdTdId" + item.person_id;
                                        universityIdTdId = "universityIdTdId" + item.person_id;
                                        facultyIdTdId = "facultyIdTdId" + item.person_id;
                                        departmentIdTdId = "departmentIdTdId" + item.person_id;
                                        phoneIdTdId = "phoneIdTdId" + item.person_id;
                                        emailIdTdId = "emailIdTdId" + item.person_id;

                                        <tr id="@item.person_id">
                                            <td>@number</td>
                                            <td id="idcardIdTdId">@item.person_idCard</td>
                                            <td id="nameIdTdId">@item.person_firstname</td>
                                            <td id="lastnameIdTdId">@item.person_lastname</td>
                                            <td id="fatherIdTdId">@item.person_father_name</td>
                                            <td id="genderIdTdId">@item.gender</td>
                                            <td id="universityIdTdId">@item.university</td>
                                            <td id="facultyIdTdId">@item.faculty</td>
                                            <td id="departmentIdTdId">@item.department</td>
                                            <td id="phoneIdTdId">@item.phone_number</td>
                                            <td id="emailIdTdId">@item.email</td>
                                            <td style="text-align:center;">
                                                <button onclick='selectPerson(@item.person_id,"@item.person_firstname","@item.person_lastname")' class="btn green mt-ladda-btn ladda-button " data-style="slide-down" data-spinner-color="#333">
                                                    <span class="ladda-label">
                                                        <i class="icon-check"></i> انتخاب
                                                    </span>
                                                    <span class="ladda-spinner"></span>
                                                </button>
                                            </td>
                                        </tr>

                                        number++;

                                    }
                                }
                            </tbody>

                        </table>



                    </div>

                </div>
                <!-- END EXAMPLE TABLE PORTLET-->

            </div>

        </div>
    </div>



    <script src="~/assets/alert.js"></script>
    <script src="~/assets/pages/scripts/components-select2.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquer.js"></script>
    <script src="~/assets/dealing/script.js"></script>
</body>
</html>






