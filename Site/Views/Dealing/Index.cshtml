@model Site.Models.DealingQueryResultViewModel

@{
    if (Session["user"] != null)
    {
        if (Session["user"].ToString() == "authenticated")
        {
            if (Session["level"].ToString() == "admin")
            {
                Layout = "~/Views/Shared/_AdminLayout.cshtml";
            }
            if (Session["level"].ToString() == "director")
            {
                Layout = "~/Views/Shared/_UserLayout.cshtml";
            }
        }
        else if (Session["user"].ToString() == "locked")
        {
            // Redirect to lock sreen page using javascript
            <script>
                window.location.href = '@Url.Action("LockScreen","User")';
            </script>
        }

    }
    else
    {
        <script>
            window.location.href = '@Url.Action("LoginView","User")';
        </script>
        
    }



}

<meta http-equiv="content-type" content="text/html;charset=UTF-8" />

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <title>دننګرهار پوهنتون دحقوقو او سیاسي علومو پوهنځي د کتابونو لست</title>
    <link href="~/assets/sweetalert.css" rel="stylesheet" />
</head>
<body>


    <div class="row">
        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet box green">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="icon-settings"></i>معامله شوي کتابونه
                    </div>
                    <div class="tools"> </div>
                </div>
                <div class="portlet-body">
                    <table class="table table-striped table-bordered table-hover" id="sample_2">
                        <thead>
                            <tr>
                                <th> شماره</th>
                                <th>تذکرې نمبر</th>
                                <th>د شخص نوم</th>
                                <th>کتاب</th>
                                <th>د وړلو تاریخ</th>
                                <th>وروستۍ نېټه</th>
                                <th>تحویل شوې پیسې</th>
                                <th style="text-align:center;">تحویلي</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int number = 1;


                                foreach (var result in Model.QueryResults)
                                {
                                    <tr id="@result.dealing_id">
                                        @*BEGIN COL 1*@
                                        <td> @number </td>
                                        @*END COL 1*@

                                        @*BEGIN COL 2*@

                                        <td> @result.person_idCard </td>
                                        @*END COL 2*@

                                        @*BEGIN COL 3*@
                                        <td> @result.person_firstname @result.person_lastname </td>
                                        @*END COL 3*@

                                        @*BEGIN COL 4*@

                                        <td>@result.publication_name</td>
                                        @*END COL 4*@

                                        @*BEGIN COL 5*@
                                        <td> @result.issue_date.ToShortDateString() </td>
                                        @*END COL 5*@

                                        @*BEGIN COL 6*@
                                        <td> @result.return_date.ToShortDateString() </td>
                                        @*END COL 6*@

                                        @*BEGIN COL 7*@
                                        <td> @result.paid_money </td>
                                        @*END COL 7*@

                                        @*BEGIN COL 7*@
                                        @{
                                            if (result.returned == true)
                                            {
                                                <td style="text-align:center;">
                                                    <button disabled class="btn green mt-ladda-btn ladda-button " data-style="slide-down" data-spinner-color="#333">
                                                        <span class="ladda-label">
                                                            <i class="icon-check"></i>
                                                        </span>
                                                        <span class="ladda-spinner"></span>
                                                    </button>
                                                </td>
                                            }
                                            else
                                            {
                                                string disableButtonId = "disableButtonId" + result.dealing_id;
                                                <td style="text-align:center;">
                                                    <button id="@disableButtonId" onclick="bookReturned(@result.dealing_id,@disableButtonId)" class="btn green mt-ladda-btn ladda-button " data-style="slide-down" data-spinner-color="#333">
                                                        <span class="ladda-label">
                                                            <i class="icon-check"></i>
                                                        </span>
                                                        <span class="ladda-spinner"></span>
                                                    </button>
                                                </td>

                                            }
                                        }
                                        @*END COL 7*@

                                    </tr>
                                    number++;
                                }


                            }



                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END EXAMPLE TABLE PORTLET-->
        </div>
    </div>
    <script src="~/assets/alert.js"></script>
    <script src="~/assets/dealing/script.js"></script>
</body>
</html>
@{
    if (Session["changed"] != null)
    {


        if (Session["changed"].ToString() == "true")
        {
            // If any record was updated than set the session to false and show an alert
            Session["changed"] = "false";
            <script type="text/javascript">
                swal("په بریالیتوب سره تغیرات ثبت شول", "", {
                    icon: "success", buttons: "  سمه ده  "
                });
            </script>
        }
    }
}
