@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}
<!DOCTYPE html>
<!--[if IE 8]> <html lang="en" class="ie8 no-js"> <![endif]-->
<!--[if IE 9]> <html lang="en" class="ie9 no-js"> <![endif]-->
<!--[if !IE]><!-->
<html lang="en" dir="rtl">
<!--<![endif]-->
<!-- BEGIN HEAD -->
<meta http-equiv="content-type" content="text/html;charset=UTF-8" />
<head>
    <meta charset="utf-8" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="" name="description" />
    <meta content="" name="author" />

    <script src="~/assets/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>

</head>
<!-- END HEAD -->

<body>



    <div class="row">
        <div class="col-md-12">
            <div class="portlet light bordered" id="form_wizard_1">
                <div class="portlet-title">
                    <div class="caption">
                        <i class=" icon-layers font-red"></i>
                        <span class="caption-subject font-red bold uppercase">
                            د تېزس ثبتول -
                            <span class="step-title"> Step 1 of 4 </span>
                        </span>
                    </div>
                    <div class="actions">
                        <a class="btn btn-circle btn-icon-only btn-default" href="javascript:;">
                            <i class="icon-cloud-upload"></i>
                        </a>
                        <a class="btn btn-circle btn-icon-only btn-default" href="javascript:;">
                            <i class="icon-wrench"></i>
                        </a>
                        <a class="btn btn-circle btn-icon-only btn-default" href="javascript:;">
                            <i class="icon-trash"></i>
                        </a>
                    </div>
                </div>
                <div class="portlet-body form">
                    <form class="form-horizontal" action="#" id="submit_form" method="POST">
                        <div class="form-wizard">
                            <div class="form-body">
                                <ul class="nav nav-pills nav-justified steps">
                                    <li>
                                        <a href="#tab1" data-toggle="tab" class="step">
                                            <span class="number"> 1 </span>
                                            <span class="desc">
                                                <i class="fa fa-check"></i> عمومي مشخصات
                                            </span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#tab2" data-toggle="tab" class="step">
                                            <span class="number"> 2 </span>
                                            <span class="desc">
                                                <i class="fa fa-check"></i> خاص مشخصات
                                            </span>

                                        </a>
                                    </li>
                                    <li>
                                        <a href="#tab3" data-toggle="tab" class="step active">
                                            <span class="number"> 3 </span>
                                            <span class="desc">
                                                <i class="fa fa-check"></i> د چاپ مشخصات
                                            </span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#tab4" data-toggle="tab" class="step">
                                            <span class="number"> 4 </span>
                                            <span class="desc">
                                                <i class="fa fa-check"></i> تایید
                                            </span>
                                        </a>
                                    </li>
                                </ul>
                                <div id="bar" class="progress progress-striped active" role="progressbar">
                                    <div class="progress-bar progress-bar-success "> </div>
                                </div>
                                <div class="tab-content">
                                    <div class="alert alert-danger display-none">
                                        <button class="close" data-dismiss="alert"></button> ستاسو په فورم کې مشکل دی. یو ځل یې وګورئ.
                                    </div>
                                    <div class="alert alert-success display-none">
                                        <button class="close" data-dismiss="alert"></button> د فورم معلومات مو سم شول
                                    </div>
                                    <div class="tab-pane active" id="tab1">
                                        <h3 class="block">د تېزس عمومي مشخصات داخل کړئ</h3>

                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د تېزس نړیوال نمبر
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" name="ISBN" id="ISBN" />
                                                <span class="help-block"> د ISBN نمبر ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د تېزس دیوي نمبر
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" name="DDC" id="DDC" />
                                                <span class="help-block"> د DDC نمبر ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د تېزس کنګرس نمبر
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" name="LLC" id="LLC" />
                                                <span class="help-block"> د LLC نمبر ولیکئ.  </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د تېزس نوم
                                                <span class="required"> * </span>
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" name="name" id="name" value="" />
                                                <span class="help-block">  دتېزس نوم ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د ژباړونکي نوم
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control" name="translator" id="translator" />
                                                <span class="help-block"> د ژباړونکي نوم ولیکئ.  </span>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                شعبه
                                                <span class="required"> * </span>
                                            </label>
                                            <div class="col-md-6 ">
                                                <select name="branch" id="branch" class="form-control">
                                                    @foreach (var branch in ViewBag.branch)
                                                    {
                                                        <option value="@branch.branch_id">@branch.branch_name</option>

                                                    }
                                                </select>
                                                <span class="help-block"> شعبه انتخاب کړئ  </span>
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                ژبه
                                                <span class="required"> * </span>
                                            </label>
                                            <div class="col-md-6">
                                                <select name="language" id="language" class="form-control select bootstrap-select">
                                                    <option value="پښتو">پښتو</option>
                                                    <option value="دری">دری</option>
                                                    <option value="فارسی">فارسی</option>
                                                    <option value="English">English</option>
                                                    <option value="عربی">عربی</option>
                                                    <option value="اردو">اردو</option>
                                                    <option value="Spanish">Spanish</option>
                                                </select>
                                                <span class="help-block">  د تېزس ژبه انتخاب کړئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                اضافه معلومات
                                            </label>
                                            <div class="col-md-6">
                                                <textarea class="form-control" rows="3" name="description" id="description"></textarea>
                                                <span class="help-block">  تېزس په اړه نور معلومات ولیکئ.  </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">لیکوالان</label>
                                            <div class="input-group select2-bootstrap-prepend col-md-6">
                                                <select id="select2-disabled-inputs-multiple" name="authors" class="form-control select2-multiple" multiple>
                                                    @foreach (var author in ViewBag.author)
                                                    {
                                                        <option value="@author.author_id">@author.author_firstname @author.author_lastname</option>
                                                    }
                                                </select>
                                                <span class="help-block">  د لیکوالانو نومونه انتخاب کړئ </span>

                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د وړنې اجازه
                                            </label>
                                            <div class="col-md-6">
                                                <div class="portlet light form-fit " style="margin-left:-5%;">
                                                    <div class="portlet-title">
                                                        <div class="actions">
                                                            <input type="checkbox" id="referenceBook" class="make-switch" data-on="success" data-on-color="success" data-off-color="danger" data-size="small">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane" id="tab2" style="height:auto;height:max-content;">
                                        <h3 class="block">د تېزس خاص مشخصات داخل کړئ</h3>

                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د رهنما استاد نوم
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" maxlength="50" class="form-control" name="supervisorFirstname" id="supervisorFirstname" />
                                                <span class="help-block"> د رهنما استاد نوم ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د رهنما استاد تخلص
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" maxlength="50" class="form-control" name="supervisorLastname" id="supervisorLastname" />
                                                <span class="help-block"> د رهنما استاد تخلص ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                داخلي مناقش
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" maxlength="50" class="form-control" name="internalConflict" id="internalConflict" />
                                                <span class="help-block"> د داخلي مناقش نوم ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                خارجي مناقش
                                            </label>
                                            <div class="col-md-6">
                                                <input type="text" maxlength="50" class="form-control" name="externalConflict" id="externalConflict" />
                                                <span class="help-block"> د خارجي مناقش نوم ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د محصل د ثبت کال
                                            </label>
                                            <div class="col-md-6">
                                                <input type="number" value="2000" class="form-control" name="studentRegistrationYear" id="studentRegistrationYear" />
                                                <span class="help-block"> د محصل د ثبت کال ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د محصل د فراغت کال
                                            </label>
                                            <div class="col-md-6">
                                                <input type="number" value="2000" class="form-control" name="studentGraduationYear" id="studentGraduationYear" />
                                                <span class="help-block"> د محصل د فراغت کال ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                د دفاع تاریخ
                                            </label>
                                            <div class="col-md-6">
                                                <input type="date" class="form-control" name="defenceDate" id="defenceDate" />
                                                <span class="help-block"> د دفاع تاریخ ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                نمرې
                                            </label>
                                            <div class="col-md-6">
                                                <input type="number" min="0" max="100" value="0" class="form-control" name="mark" id="mark" />
                                                <span class="help-block"> نمرې ولیکئ. </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label col-md-3">
                                                 د فراغت دور
                                            </label>
                                            <div class="col-md-6">
                                                <input type="number" value="1" class="form-control" name="graduationPeriod" id="graduationPeriod" />
                                                <span class="help-block"> د فراغت دور ولیکئ. </span>
                                            </div>
                                        </div>
                                        

                                    </div>

                                    <div class="tab-pane" id="tab3">
                                        <h3 class="block">د چاپ یا ایډېشن معلومات داخل کړئ </h3>
                                        
                                        <div class="row">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-10">
                                                <!-- BEGIN Portlet PORTLET-->
                                                <div class="portlet box green">
                                                    <div class="portlet-title">
                                                        <div class="caption">
                                                            <i class="icon-layers"></i> د چاپ/ایدېشن اړونده فورم
                                                        </div>
                                                        <div class="tools">
                                                            <a href="javascript:;" class="collapse" data-original-title="" title=""> </a>
                                                            <a href="#" class="fullscreen" data-original-title="" title=""> </a>
                                                        </div>
                                                    </div>
                                                    <div class="portlet-body" style="display: block; ">
                                                        <div class="slimScrollDiv" style="position: relative;  width: auto; height: auto;">
                                                            <div class="scroller" style="height: auto;  width: auto;" data-initialized="1">
                                                                <br />
                                                                
                                                                <div class="form-group publicationQuantity">
                                                                    <label class="control-label col-md-3">
                                                                        مقدار/تعداد
                                                                        <span class="required"> * </span>
                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="1" max="50" class="form-control publicationQuantity" name="publicationQuantity" id="publicationQuantity" value="1" />
                                                                        <span class="help-block">  مقدار/تعداد مشخص کړئ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group publicationPages">
                                                                    <label class="control-label col-md-3">
                                                                        صفحې
                                                                        <span class="required"> * </span>
                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="10" max="5000" class="form-control publicationPages" name="publicationPages" id="publicationPages" value="100" />
                                                                        <span class="help-block">  څو صفحې دی؟ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group CDQuantity">
                                                                    <label class="control-label col-md-3">
                                                                        د سي ډي/ CD تعداد
                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="0" max="10" class="form-control CDQuantity" name="CDQuantity" id="CDQuantity" value="0" />
                                                                        <span class="help-block">  د سي ډي/ CD تعداد </span>
                                                                    </div>
                                                                </div>

                                                                <div class="form-group registrationDateType">
                                                                    <label class="control-label col-md-3">
                                                                        د ثبت د تاریخ ډول
                                                                        <span class="required"> * </span>
                                                                    </label>
                                                                    <div class="col-md-8 ">
                                                                        <select name="registrationDateType" id="registrationDateType" class="form-control registrationDateType">
                                                                            <option selected value="شمسي">هجري شمسي</option>
                                                                            <option value="قمري">هجري قمري</option>
                                                                            <option value="میلادي">میلادي</option>
                                                                        </select>
                                                                        <span class="help-block"> د ثبت د تاریخ ډول انتخاب کړئ  </span>
                                                                    </div>
                                                                </div>

                                                                <div class="form-group registrationDate">
                                                                    <label class="control-label col-md-3">
                                                                        د ثبت تاریخ
                                                                        <span class="required"> * </span>
                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="date" class="form-control registrationDate" name="registrationDate" id="registrationDate" value="" />
                                                                        <span class="help-block"> د ثبت تاریخ ولیکئ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group publicationDateType">
                                                                    <label class="control-label col-md-3">
                                                                        د تأسیس د تاریخ ډول
                                                                        <span class="required"> * </span>
                                                                    </label>
                                                                    <div class="col-md-8 ">
                                                                        <select name="publicationDateType" id="publicationDateType" class="form-control publicationDateType">
                                                                            <option selected value="شمسي">هجري شمسي</option>
                                                                            <option value="قمري">هجري قمري</option>
                                                                            <option value="میلادي">میلادي</option>
                                                                        </select>
                                                                        <span class="help-block"> د تأسیس د تاریخ ډول انتخاب کړئ  </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group publicationYear">
                                                                    <label class="control-label col-md-3">
                                                                        د تأسیس کال
                                                                        <span class="required"> * </span>
                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="1" max="4000" class="form-control publicationYear" name="publicationYear" id="publicationYear" value="2000" />
                                                                        <span class="help-block"> د تأسیس کال ولیکئ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group publicationMonth">
                                                                    <label class="control-label col-md-3">
                                                                        د تأسیس میاشت

                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="1" max="12" class="form-control publicationMonth" name="publicationMonth" id="publicationMonth" value="" />
                                                                        <span class="help-block"> د تأسیس میاشت ولیکئ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group publicationDay">
                                                                    <label class="control-label col-md-3">
                                                                        د تأسیس ورځ

                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="1" max="31" class="form-control publicationDay" name="publicationDay" id="publicationDay" value="" />
                                                                        <span class="help-block"> د تأسیس ورځ ولیکئ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group cupboardNo">
                                                                    <label class="control-label col-md-3">
                                                                        د المارۍ نمبر

                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="1" max="1000" class="form-control cupboardNo" name="cupboardNo" id="cupboardNo" value="" />
                                                                        <span class="help-block"> د المارۍ نمبر مشخص کړئ </span>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group cellNo">
                                                                    <label class="control-label col-md-3">
                                                                        د خانې نمبر

                                                                    </label>
                                                                    <div class="col-md-8">
                                                                        <input type="number" min="1" max="20" class="form-control cellNo" name="cellNo" id="cellNo" value="" />
                                                                        <span class="help-block"> د خانې نمبر مشخص کړئ </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="slimScrollBar" style="background: rgb(187, 187, 187); width: 7px; position: absolute; top: 0px; opacity: 0.4; display: none; border-radius: 7px; z-index: 99; left: 1px; height: 41.6667px;">
                                                            </div>
                                                            <div class="slimScrollRail" style="width: 7px; height: 100%; position: absolute; top: 0px; display: none; border-radius: 7px; background: rgb(234, 234, 234); opacity: 0.2; z-index: 90; left: 1px;">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- END Portlet PORTLET-->
                                            </div>

                                        </div>


                                    </div>
                                    <div class="tab-pane" id="tab4">
                                        <h3 class="block">د تېزس معلومات تأیید کړئ</h3>
                                        <h4 class="form-section"> د تېزس عمومي مشخصات</h4>
                                        <div class="row">
                                            <div class="col-md-1"></div>
                                            <div class="col-md-10">
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label "> د تېزس نړیوال نمبر  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="ISBN"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label ">د تېزس دیوي نمبر  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="DDC"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label ">د تېزس کنګرس نمبر  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="LLC"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label ">د تېزس نوم  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="name"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label ">د ژباړونکي نوم  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="translator"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label "> شعبه  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="branch"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label "> ژبه  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="language"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        <label class="control-label "> اضافه معلومات  </label>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <p class="form-control-static" data-display="description"> </p>
                                                    </div>
                                                </div>
                                                <div class="form-group">
