@model Site.Models.Newspaper

@{
    if (Session["user"] != null)
    {
        if (Session["user"].ToString() == "authenticated")
        {
            if (Session["level"].ToString() == "admin")
            {
                Layout = "~/Views/Shared/_AdminLayout.cshtml";
            }
            if (Session["level"].ToString() == "director")
            {
                Layout = "~/Views/Shared/_UserLayout.cshtml";
            }
        }
        else if (Session["user"].ToString() == "locked")
        {
            // Redirect to lock sreen page using javascript
            <script>
                window.location.href = '@Url.Action("LockScreen","User")';
            </script>
        }

    }
    else
    {
        <script>
            window.location.href = '@Url.Action("LoginView","User")';
        </script>
    }

}

<html>
<head>

</head>
<body>
    <div class="note note-success">
        <h3 style="color: gray; font-weight:bold; text-align:center;"> د اخبار د تغیرولو فورم</h3>
    </div>

    <div>
        <form>
            <div class="row">
                <input type="hidden" id="newspaper_id" value="@Model.newspaper_id" />
                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:24px">د اخبار نوم</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control" id="newspaper_name" name="newspaper_name" style="border-radius:6px;" placeholder="د اخبار نوم" value="@Model.newspaper_name">
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:24px">د مطبعې نوم</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="text" class="form-control" id="publisher_name" name="publisher_name" style="border-radius:6px;" placeholder="د مطبعې نوم" value="@Model.publisher_name">
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size:24px">د اخبار تعداد</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="number" class="form-control" id="newspaper_quantity" name="newspaper_quantity" style="border-radius:6px;" placeholder="د اخبارتعداد" value="@Model.quantity">
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size: 24px">د تاریخ ډول</label>

                    </div>

                    <div class=" col-md-6">
                        <select class="form-control" style="padding: 5px; border-radius: 6px;" id="dateType">
                            @{
                                if (Model.date_type == "میلادی")
                                {
                                    <option style="font-size:24px;" value="میلادی" selected>میلادی </option>

                                }
                                else
                                {
                                    <option style="font-size:24px;" value="میلادی">میلادی </option>
                                }
                                if (Model.date_type == "شمسی")
                                {
                                    <option style="font-size:24px;" value="شمسی" selected>شمسی </option>
                                }
                                else
                                {
                                    <option style="font-size:24px;" value="شمسی">شمسی </option>
                                }
                            }



                        </select>
                        <br />

                    </div>

                </div>



                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size: 24px">د چاپ  نیټه</label>

                    </div>

                    <div class=" col-md-6">

                        <input type="date" class="form-control" id="publication_date" name="publication_date" style="border-radius:6px;" placeholder="د چاپ  نیټه" value='@Model.publication_date.ToString("yyyy-MM-dd")'>
                        <br />

                    </div>

                </div>

                <div class="col-md-1"></div>
                <div class="form-group col-md-11">
                    <div class="col-md-2 ">

                        <label style="font-size: 24px">د ثبتولو نیټه</label>

                    </div>

                    <div class=" col-md-6">
                        <input type="date" class="form-control" id="registration_date" name="registration_date" style="border-radius:6px;" placeholder="د ثبتولو نیټه" value="@Model.registration_date.ToString("yyyy-MM-dd")">
                        <br />

                    </div>

                </div>

                <div class="col-md-8">
                    <button type="button" class="btn green mt-ladda-btn ladda-button btn-outline pull-right" data-style="slide-down" data-spinner-color="#333" style="padding:6px 20px 6px 20px;" onclick="UpdateRecord()">
                        <span class="ladda-label">
                            <i id="icon" class="fa fa-edit"></i> تغیرول
                        </span>
                        <span class="ladda-spinner"></span>
                    </button>
                </div>

            </div>
        </form>
    </div>



    <script type="text/javascript">

        function UpdateRecord() {
            var newspaperId = document.getElementById("newspaper_id").value;
            var NewspaperName = document.getElementById("newspaper_name").value;
            var PublisherName = document.getElementById("publisher_name").value;
            var NewspaperQuantity = document.getElementById("newspaper_quantity").value;
            var DateType = document.getElementById("dateType").value;
            var PublicationDate = document.getElementById("publication_date").value;
            var RegistrationDate = document.getElementById("registration_date").value;
            if (NewspaperName == "") {
                document.getElementById("newspaper_name").style.border = "1px solid red";

            }
            else if (/^\d+$/.test(NewspaperName)) {
                swal(" د اخبار نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
                document.getElementById("newspaper_name").style.border = "1px solid red";
                document.getElementById("newspaper_name").focus();
            }
            else if (PublisherName == "") {
                document.getElementById("publisher_name").style.border = "1px solid red";

            }
            else if (/^\d+$/.test(PublisherName)) {
                swal(" د مطبعي نوم صحې ولیکئ", "", {
                    icon: "error",
                    buttons: "سمه ده"

                });
            }
            else if (NewspaperQuantity == "") {
                document.getElementById("newspaper_quantity").style.border = "1px solid red";
            }
            else if (DateType == "") {
                document.getElementById("dateType").style.border = "1px solid red";
            }
            else if (PublicationDate == "") {
                document.getElementById("publication_date").style.border = "1px solid red";
            }
            else if (RegistrationDate == "") {
                document.getElementById("registration_date").style.border = "1px solid red";
            }

            else {
                alert("function call");


                var obj = {
                    newspaper_id: newspaperId,
                    newspaper_name: NewspaperName,
                    publisher_name: PublisherName,
                    quantity: NewspaperQuantity,
                    date_type: DateType,
                    publication_date: PublicationDate,
                    registration_date: RegistrationDate

                };

                $.ajax({

                    url: "/Newspaper/NewspaperEdit",
                    type: "post",
                    data: obj,
                    success: function (response) {
                        if (response == true) {

                            window.location.href = "/Newspaper/NewspaperView";

                        }
                        else if (response == false) {
                            swal("ستونزه رامنځته شوه", "", {
                                icon: "error",
                                buttons: "سمه ده"

                            });
                        }

                        else {
                            swal("ستونزه رامنځته شوه", "", {
                                icon: "error",
                                buttons: "سمه ده"

                            });

                        }
                    },
                    error: function (error) {
                        swal("ستونزه رامنځته شوه", "", {
                            icon: "error",
                            buttons: "سمه ده"

                        });
                    }

                });
            }
        }

    </script>

    <script src="~/assets/alert.js"></script>
</body>
</html>
