<body class="">

    <div class="page-lock">
        <div class="page-logo" style="margin-top:-20px;">
            <a class="brand" href="index.html">
                <img src="~/assets/pages/img/logo-big.png" width="104" alt="logo">
            </a>
        </div>
        <div class="page-body">
            <div class="lock-head"> قفـــــل </div>
            <div class="lock-body">
                <div class="pull-left lock-avatar-block">
                    <img src="@Url.Action("DisplayImage","User")" width="110" class="lock-avatar">
                </div>
                <form class="lock-form pull-left" id="lockscreenPasswordForm" method="post">
                    <h4>@Session["username"]</h4>
                    <div class="form-group">
                        <input class="form-control placeholder-no-fix" type="password" autocomplete="off" placeholder="پټ نوم" name="password" id="lockscreenPassword">
                        
                    </div>

                    <span style="color:orangered;" id="emptyPasswordError"></span>
                    <div class="form-actions">
                        <button type="submit" class="btn red uppercase">داخلېدل</button>
                    </div>
                </form>
            </div>
            <div class="lock-bottom">
                <a href="/User/LoginView"> نـه یـم @Session["username"] </a>
            </div>
        </div>
    </div>

    <!-- /.modal -->
    <div class="modal fade bs-modal-sm" id="incorrectPassworModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">

                    <h4 class="modal-title">ناسمه ننوتنه</h4>
                    <div>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        &nbsp;&nbsp;&nbsp;&nbsp;

                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">مهرباني وکړئ سم کوډ داخل کړئ.</div>
                <div class="modal-footer">
                    <button type="button" id="okButton" class="btn green btn-outline" data-dismiss="modal">سمه ده</button>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>

    <div>
        <a href="#">content</a>
    </div>
    <script src="~/assets/alert.js"></script>

    <script type="text/javascript">



        // Validation and submition of lock screen password to controller
        document.getElementById("lockscreenPasswordForm").addEventListener('submit', function (event) {
            event.preventDefault();
            var password = $('#lockscreenPassword').val();
            if (password == "") {
                document.getElementById('emptyPasswordError').innerHTML = "کوډ مو داخل کړئ.";

            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/User/UnLock",
                    data: { password: password },
                    success: function (response) {
                        if (response == "true") {
                            window.history.back();
                        }
                        else if (response == "false") {

                            swal("نا سم کوډ مو داخل کړ", "", {
                                icon: "warning", buttons: "سمه ده"
                            });
                            //$("#lockscreenPassword").focus();
                        }
                        else {
                            swal("ستونزه رامنځته شوه", "Exception: " + response.responseText, {
                                icon: "error", buttons: "سمه ده"
                            });
                        }
                        $('#lockscreenPassword').val('');


                    },
                    error: function (xhr, status, error) {
                        swal("ستونزه رامنځته شوه", "Error: " + error, {
                            icon: "error", buttons: "سمه ده"
                        });
                    }
                });
            }
        });
        document.getElementById("lockscreenPassword").addEventListener('input', function (event) {
            event.preventDefault();
            var emptyPasswordError = document.getElementById('emptyPasswordError');
            emptyPasswordError.innerHTML = "";
            

        });




    </script>

    <!-- /.modal -->
