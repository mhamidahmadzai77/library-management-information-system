
@{
    Layout = "~/Views/Shared/_SimpleLayout2.cshtml";
    ViewBag.Title = "ResetPasswordView";
}
<!DOCTYPE html>
<!--

<!--[if IE 8]> <html lang="en" class="ie8 no-js"> <![endif]-->
<!--[if IE 9]> <html lang="en" class="ie9 no-js"> <![endif]-->
<!--[if !IE]><!-->
<html lang="en" dir="rtl">
<!--<![endif]-->
<!-- BEGIN HEAD -->
<head>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" />

    <style>
        .error {
            color: red;
        }
    </style>
</head>
<!--END HEAD-->

<body class=" login" onload="LoadResetPasswordView();">
    <script type="text/javascript">

        function LoadResetPasswordView() {
            jQuery(".forget-form").show();
        }


    </script>

    <!-- BEGIN LOGO -->
    <div class="logo" style="margin-top:20px;">
        <a href="index.html">
            <img src="~/assets/pages/img/logo-big.png" width="104" alt="" />
        </a>
    </div>
    <!-- END LOGO -->
    <!-- BEGIN FORGOT PASSWORD -->
    
    <div class="content">
        <!-- BEGIN FORGOT PASSWORD FORM -->
        <form class="forget-form show" id="resetPasswordForm">

            <h3>ایا پټ نوم دې له یاده وتلی؟</h3>
            <p> د پټ نوم د بدلولو لپاره مو خپل نوم او ایمیل ولیکئ. </p>

            <div class="alert alert-danger display-hide" id="emptyFieldsAlert" role="alert">
                <button class="close" id="closeAlert" data-close="alert"></button>
                <span> نوم او کوډ مو داخل کړئ. </span>
            </div>
            <div class="form-group">
                <!--ie8, ie9 does not support html5 placeholder, so we just show field title for that-->
                <label class="control-label visible-ie8 visible-ie9">Username</label>
                <div class="input-icon">
                    <i class="fa fa-user"></i>
                    <input class="form-control placeholder-no-fix" type="text" autocomplete="off" placeholder="نوم" name="username" id="username" />
                    <span id="usernameError" class="error"></span><br>
                </div>
            </div>
            <div class="form-group">
                <div class="input-icon">
                    <i class="fa fa-envelope"></i>
                    <input class="form-control placeholder-no-fix" type="text" autocomplete="off" placeholder="ایمیل" id="email" name="email" />
                    <span id="emailError" class="error"></span><br>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" id="submitBtn" class="btn green pull-right"> تغیر </button>
            </div>

        </form>
        <!-- END FORGOT PASSWORD FORM -->
    </div>
        
    <!-- END FORGOT PASSWORD -->
    
    <script src="~/assets/my script/script.js"></script>
    <script src="~/assets/global/plugins/jquery.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/js.cookie.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/jquery-slimscroll/jquery.slimscroll.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/jquery.blockui.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/bootstrap-switch/js/bootstrap-switch.min.js" type="text/javascript"></script>
    <!-- END CORE PLUGINS -->
    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <script src="~/assets/global/plugins/jquery-validation/js/jquery.validate.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/jquery-validation/js/additional-methods.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    <script src="~/assets/global/plugins/backstretch/jquery.backstretch.min.js" type="text/javascript"></script>



    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <script src="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.js" type="text/javascript"></script>
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL SCRIPTS -->
    <script src="~/assets/global/scripts/app.min.js" type="text/javascript"></script>
    <!-- END THEME GLOBAL SCRIPTS -->
    @Scripts.Render("~/bundles/bootstrap")
<script src="~/assets/alert.js"></script>
    <script src="~/assets/script.js"></script>
    <script src="~/assets/jquer.js"></script>

    <script type="text/javascript">

    </script>
</body>



