
@{
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
    ViewBag.Title = "ConfirmPasswordView";
}



<body class=" login">
    <!-- BEGIN LOGO -->
    <div class="logo" style="margin-top:20px;">
        <a href="index.html">
            <img src="~/assets/pages/img/logo-big.png" width="104" alt="" />
        </a>
    </div>
    <!-- END LOGO -->
    <!-- BEGIN CONFIRM PASSWORD -->
    <div class="content">

        <form class="" method="post" id="confirmPasswordForm">

            <h3>خپل حساب ته داخل شئ</h3>
            <p> د حساب نوی کوډ مو ایمیل ادرس ته لېږدول شوی. </p>
            <div class="alert alert-danger display-hide" id="emptyAlert" role="alert">
                <button class="close" id="closeAlert" data-close="alert"></button>
                <span> کوډ باید شپږ (۶) حروف وي </span>
            </div>
            <div class="form-group">
                <div class="input-icon">
                    <i class="fa fa-lock"></i>
                    <input class="form-control placeholder-no-fix" type="password" autocomplete="off" placeholder="پټ نوم" name="password" id="password" />
                </div>
            </div>
            <div class="form-action">
                <br />
                <br />
                <button type="submit" class="btn green pull-right" id="btnSubmitPassword"> داخلېدل </button>
            </div>
        </form>

    </div>
    <!-- END CONFIRM PASSWORD -->
  
