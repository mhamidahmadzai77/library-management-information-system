    <script type="text/javascript">


        // CHANGE PASSWORD FORM HANDLING WHILE SUBMITING
        document.getElementById("changePasswordForm").addEventListener('submit', function (event) {
            event.preventDefault();
            var currentPassword = $('#currentPassword').val();
            var newPassword = $('#newPassword').val();
            var confirmPassword = $('#confirmPassword').val();

            if (currentPassword.length > 5 && currentPassword.length < 26 && newPassword.length > 5 && newPassword.length < 26 && confirmPassword.length > 5 && confirmPassword.length < 26) {

                if (newPassword != confirmPassword) {
                    swal("خطا", "  نوی کوډ مو و نه منل شو، نوی کوډ باید دواړو ځایونو کې یو ډول وي.", {
                        icon: "info", buttons: "سمه ده"
                    });
                }
                else {
                    var obj = {
                        currentPassword: currentPassword,
                        newPassword: newPassword
                    };

                    $.ajax({
                        type: "POST",
                        url: "/User/EditPassword",
                        data: obj,
                        success: function (response) {

                            if (response == "password changed") {
                                swal("چاره بریالئ وه", "ستاسو د حساب کوډ په بریاليتوب سره تغیر شو.", {
                                    icon: "success", buttons: "سمه ده"
                                });

                            }
                            else if (response == "incorrect password entered") {

                                swal("خطا", "مخکنی کوډ مو غلط دی، مهرباني وکړې سم کوډ داخل کړئ.", {
                                    icon: "error", buttons: "سمه ده"
                                });

                            }
                            else {
                                swal("ستونزه رامنځته شوه", "Exception: " + response.responseText, {
                                    icon: "info", buttons: "سمه ده"
                                });
                            }
                            $('#currentPassword').val('');
                            $('#newPassword').val('');
                            $('#confirmPassword').val('');

                        },
                        error: function (xhr, status, error) {
                            swal("ستونزه رامنځته شوه", "Error: " + error, {
                                    icon: "info", buttons: "سمه ده"
                                });
                        }
                    });
                }
            }
            else {
                document.getElementById('currentPassword').style.border = "1px solid red";
                document.getElementById('newPassword').style.border = "1px solid red";
                document.getElementById('confirmPassword').style.border = "1px solid red";
            }

        });

        //Change profile image


        document.getElementById("changeImageForm").addEventListener('submit', function (event) {
            event.preventDefault();

            var image = $('#image').get(0).files[0];

            var formData = new FormData();
            formData.append('image', image);

            $.ajax({
                type: 'POST',
                url: '/User/ChangeImage',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.redirectTo) {
                        window.location.href = response.redirectTo;
                    }
                    else if (response == "file not selected") {
                        swal("مهرباني وکړئ یو انځور انتخاب کړئ","", {
                            icon: "info", buttons: "سمه ده"
                        });
                    } else if (response == "image not changed") {
                        swal("ستونزه رامنځته شوه", "د یوې ستونزې له امله انځور و نه ټاکل شو، مهرباني وکړئ بیا هڅه وکړئ!", {
                            icon: "info", buttons: "سمه ده"
                        });
                    }
                    else {
                        swal("ستونزه رامنځته شوه", "Exception: " + response.responseText, {
                            icon: "info", buttons: "سمه ده"
                        });
                    }


                },
                error: function (error) {
                    swal("ستونزه رامنځته شوه", "Error: " + error, {
                        icon: "error", buttons: "سمه ده"
                    });
                }
            });
        });




        // Current password textbox validation checking
        $("#currentPassword").on("input", function () {

            var currentPasswordText = $('#currentPassword').val();
            if (currentPasswordText == "") {
                document.getElementById('currentPassword').style.border = "1px solid red";
                document.getElementById('currentPasswordError').innerHTML = "اوسنی کوډ مو داخل کړئ.";

            }
            else {
                document.getElementById('currentPassword').style.border = "";
                if (currentPasswordText.length > 25 || currentPasswordText.length < 6) {
                    document.getElementById('currentPasswordError').innerHTML = "کوډ باید له ۶ حروفو/اعدادو څخه کوچنی او له ۲۵ حروفو/اعدادو څخه لوی نه وي";
                }
                else {
                    document.getElementById('currentPasswordError').innerHTML = "";
                }
            }
        });

        // New password textbox validation checking
        $("#newPassword").on("input", function () {

            var newPasswordText = $('#newPassword').val();
            if (newPasswordText == "") {
                document.getElementById('newPassword').style.border = "1px solid red";
                document.getElementById('newPasswordError').innerHTML = "نوی کوډ مو داخل کړئ.";

            }
            else {
                document.getElementById('newPassword').style.border = "";
                if (newPasswordText.length > 25 || newPasswordText.length < 6) {
                    document.getElementById('newPasswordError').innerHTML = "کوډ باید له ۶ حروفو/اعدادو څخه کوچنی او له ۲۵ حروفو/اعدادو څخه لوی نه وي";
                }
                else {
                    document.getElementById('newPasswordError').innerHTML = "";
                }
            }
        });

        // Confirm password textbox validation checking
        $("#confirmPassword").on("input", function () {

            var confirmPasswordText = $('#confirmPassword').val();
            if (confirmPasswordText == "") {
                document.getElementById('confirmPassword').style.border = "1px solid red";
                document.getElementById('confirmPasswordError').innerHTML = "نوی کوډ مو بیا داخل کړئ.";

            }
            else {
                document.getElementById('confirmPassword').style.border = "";
                if (confirmPasswordText.length > 25 || confirmPasswordText.length < 6) {
                    document.getElementById('confirmPasswordError').innerHTML = "کوډ باید له ۶ حروفو/اعدادو څخه کوچنی او له ۲۵ حروفو/اعدادو څخه لوی نه وي";
                }
                else {
                    document.getElementById('confirmPasswordError').innerHTML = "";
                }
            }
        });



        var username = $('#username').val();
        var email = $('#email').val();

        function resetPersonalDetail() {

            document.getElementById('username').style.border = "";
            document.getElementById('usernameError').innerHTML = "";
            document.getElementById('email').style.border = "";
            document.getElementById('emailError').innerHTML = "";
            $('#username').val(username);
            $('#email').val(email);
        }

        function clearPasswordForm() {
            $('#currentPassword').val('');
            $('#newPassword').val('');
            $('#confirmPassword').val('');
            document.getElementById('currentPassword').style.border = "";
            document.getElementById('currentPasswordError').innerHTML = "";
            document.getElementById('newPassword').style.border = "";
            document.getElementById('newPasswordError').innerHTML = "";
            document.getElementById('confirmPassword').style.border = "";
            document.getElementById('confirmPasswordError').innerHTML = "";
            document.getElementById('confirmPassword').style.border = "";
        }



        var sessionValue = "@Session["level"]";
        var dropdown = document.getElementById('level');
        for (var i = 0; i < dropdown.options.length; i++) {
            if (dropdown.options[i].value === sessionValue) {
                dropdown.selectedIndex = i;
                break;
            }
        }


        function deleteConfirmation() {

            swal({
                title: "ایا تاسو ډاډه یاست؟",
                text: "یو ځل چې انځور له منځه لاړ د بیا ځل لپاره یې نشئ ترلاسه کولی!",
                icon: "warning",
                buttons: ["نه", "هو"]
                ,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        // If user clicked yes button

                        $.ajax({
                            type: 'POST',
                            url: '/User/DeleteImage',
                            data: null,
                            success: function (response) {
                                if (response.redirectTo) {
                                    window.location.href = response.redirectTo;

                                }
                                else if (response == false) {
                                    swal("د یوې ستونزې له ستاسو غوښتنې صورت ونه موند.","", {
                                        icon: "error", buttons: "سمه ده"
                                    });
                                }
                                else {
                                    swal("ستونزه رامنځته شوه!", "Exception: " + response.responseText, {
                                        icon: "error", buttons: "سمه ده"
                                    });
                                }


                            },
                            error: function (error) {
                                swal("ستونزه رامنځته شوه!", "Error: " + error.responseText, {
                                    icon: "error", buttons: "سمه ده"
                                });

                            }
                        });




                    }
                });
        }





    </script>

    @{

        if (Session["imageState"] != null)
        {


            if (Session["imageState"].ToString() == "deleted")
            {
                // If image was deleted than set the session to false and show an alert
                Session["imageState"] = "";
                <script type="text/javascript">
                    swal("په بریالیتوب سره انځور له منځه لاړ.", "", {
                        icon: "info",
                        buttons: "سمه ده"
                    });

                </script>

            }
            if (Session["imageState"].ToString() == "updated")
            {
                // If image was deleted than set the session to false and show an alert
                Session["imageState"] = "";
                <script type="text/javascript">
                    swal("په بریالیتوب سره انځور وټاکل شو.", "", {
                        icon: "success",
                        buttons: "سمه ده"
                    });

                </script>

            }
        }
    }



</body>
</html>
